import React, { useState, useMemo } from 'react';
import { AreaChart, Area, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer } from 'recharts';

const RetirementCalculator = () => {
  const [currentAge] = useState(35);
  const [retirementAge, setRetirementAge] = useState(65);
  const [lifeExpectancy, setLifeExpectancy] = useState(98);
  const [investableAssets, setInvestableAssets] = useState(500000);
  const [monthlySavings, setMonthlySavings] = useState(2000);
  const [monthlyExpenses, setMonthlyExpenses] = useState(5500);
  const [annualReturn, setAnnualReturn] = useState(6);
  const [avgAnnualIncome, setAvgAnnualIncome] = useState(85000);
  const [additionalIncome, setAdditionalIncome] = useState(1200);
  const [inflationRate, setInflationRate] = useState(4.78);
  const [shouldCalculate, setShouldCalculate] = useState(true);

  // Calculate Social Security benefit (simplified formula based on average indexed monthly earnings)
  const socialSecurityBenefit = useMemo(() => {
    // Simplified calculation: roughly 40% replacement rate for middle income
    const monthlyIncome = avgAnnualIncome / 12;
    const estimatedBenefit = monthlyIncome * 0.40;
    return Math.round(Math.min(estimatedBenefit, 3822)); // Max SS benefit cap for 2024
  }, [avgAnnualIncome]);

  // Calculate retirement projections
  const calculations = useMemo(() => {
    if (!shouldCalculate) return null;

    const yearsToRetirement = Math.max(0, retirementAge - currentAge);
    const yearsInRetirement = Math.max(0, lifeExpectancy - retirementAge);
    
    if (yearsInRetirement <= 0) {
      return {
        portfolioAtRetirement: investableAssets,
        projectionData: [],
        healthScore: 0,
        portfolioLasts: false
      };
    }

    const monthlyReturnRate = annualReturn / 100 / 12;
    const annualInflationRate = inflationRate / 100;

    // Accumulation phase - calculate portfolio at retirement
    let portfolioAtRetirement = investableAssets;
    for (let i = 0; i < yearsToRetirement * 12; i++) {
      portfolioAtRetirement = portfolioAtRetirement * (1 + monthlyReturnRate) + monthlySavings;
    }

    // Distribution phase simulation
    const projectionData = [];
    let currentPortfolio = portfolioAtRetirement;
    const totalMonthlyIncome = socialSecurityBenefit + additionalIncome;
    let currentMonthlyExpenses = monthlyExpenses;

    // Track when portfolio runs out
    let portfolioDepletedAge = null;

    for (let year = 0; year <= yearsInRetirement; year++) {
      const age = retirementAge + year;
      
      // Record data point at the start of each year
      projectionData.push({
        age,
        portfolio: Math.round(Math.max(0, currentPortfolio)),
        expenses: Math.round(currentMonthlyExpenses * 12)
      });

      // If portfolio is already depleted, continue showing zero
      if (currentPortfolio <= 0) {
        if (!portfolioDepletedAge) {
          portfolioDepletedAge = age;
        }
        continue;
      }

      // Process each month of this year
      for (let month = 0; month < 12; month++) {
        const netMonthlyWithdrawal = currentMonthlyExpenses - totalMonthlyIncome;
        currentPortfolio = currentPortfolio * (1 + monthlyReturnRate) - netMonthlyWithdrawal;
        
        if (currentPortfolio < 0) {
          currentPortfolio = 0;
          if (!portfolioDepletedAge) {
            portfolioDepletedAge = age;
          }
          break;
        }
      }
      
      // Apply annual inflation to expenses
      currentMonthlyExpenses *= (1 + annualInflationRate);
    }

    // Calculate health score based on multiple factors
    let healthScore = 100;
    
    // Factor 1: Does portfolio last through retirement?
    if (portfolioDepletedAge && portfolioDepletedAge < lifeExpectancy) {
      const yearsShort = lifeExpectancy - portfolioDepletedAge;
      healthScore -= Math.min(50, yearsShort * 5); // Lose points for years short
    }
    
    // Factor 2: Savings rate adequacy
    const totalRetirementNeeds = monthlyExpenses * 12 * yearsInRetirement;
    const totalIncome = totalMonthlyIncome * 12 * yearsInRetirement;
    const portfolioNeeded = totalRetirementNeeds - totalIncome;
    
    if (portfolioNeeded > 0) {
      const adequacyRatio = portfolioAtRetirement / portfolioNeeded;
      if (adequacyRatio < 1) {
        healthScore = Math.max(0, Math.min(healthScore, adequacyRatio * 100));
      }
    }
    
    // Factor 3: Income replacement ratio
    const monthlyIncomeInRetirement = totalMonthlyIncome;
    const currentMonthlyIncome = avgAnnualIncome / 12;
    const replacementRatio = monthlyIncomeInRetirement / currentMonthlyIncome;
    
    if (replacementRatio < 0.7) { // Target 70% replacement
      healthScore -= (0.7 - replacementRatio) * 50;
    }

    return {
      portfolioAtRetirement: Math.round(portfolioAtRetirement),
      projectionData,
      healthScore: Math.max(0, Math.min(100, Math.round(healthScore))),
      portfolioLasts: !portfolioDepletedAge || portfolioDepletedAge >= lifeExpectancy,
      portfolioDepletedAge
    };
  }, [shouldCalculate, currentAge, retirementAge, lifeExpectancy, investableAssets, monthlySavings, 
      monthlyExpenses, annualReturn, socialSecurityBenefit, additionalIncome, inflationRate, avgAnnualIncome]);

  const getScoreColor = (score) => {
    if (score <= 40) return '#DC2626';
    if (score <= 60) return '#F59E0B';
    if (score <= 80) return '#84CC16';
    return '#16A34A';
  };

  const getStatusMessage = (score) => {
    if (score <= 40) return 'Critical Action Required';
    if (score <= 60) return 'Needs Improvement';
    if (score <= 80) return 'On Track';
    return 'Excellent Planning';
  };

  const getStatusDescription = (score, lifeExp) => {
    return `We estimate you may have ${score}% of what you need to reach your life expectancy of ${lifeExp}, based on your inputs. You may need to save more or spend less.`;
  };

  const score = calculations?.healthScore || 0;
  const scoreColor = getScoreColor(score);
  const statusMessage = getStatusMessage(score);
  const statusDescription = getStatusDescription(score, lifeExpectancy);

  // Format Y-axis values
  const formatYAxis = (value) => {
    if (value >= 1000000) {
      return `$${(value / 1000000).toFixed(1)}M`;
    }
    if (value >= 1000) {
      return `$${(value / 1000).toFixed(0)}K`;
    }
    return `$${value}`;
  };

  // Generate X-axis ticks every 5 years
  const generateXAxisTicks = () => {
    const ticks = [];
    for (let age = retirementAge; age <= lifeExpectancy; age += 5) {
      ticks.push(age);
    }
    if (ticks[ticks.length - 1] !== lifeExpectancy) {
      ticks.push(lifeExpectancy);
    }
    return ticks;
  };

  // Calculate improvement scenarios
  const calculateScenarios = useMemo(() => {
    if (!calculations) return null;

    // Scenario 1: Save More - increase monthly savings by a calculated amount
    const additionalSavingsNeeded = Math.round((100 - score) * monthlySavings / 50);
    const newMonthlySavings = monthlySavings + additionalSavingsNeeded;
    
    // Calculate new score with increased savings
    const yearsToRetirement = Math.max(0, retirementAge - currentAge);
    const monthlyReturnRate = annualReturn / 100 / 12;
    let newPortfolio = investableAssets;
    for (let i = 0; i < yearsToRetirement * 12; i++) {
      newPortfolio = newPortfolio * (1 + monthlyReturnRate) + newMonthlySavings;
    }
    const yearsInRetirement = Math.max(0, lifeExpectancy - retirementAge);
    const totalMonthlyIncome = socialSecurityBenefit + additionalIncome;
    const totalRetirementNeeds = monthlyExpenses * 12 * yearsInRetirement;
    const totalIncome = totalMonthlyIncome * 12 * yearsInRetirement;
    const portfolioNeeded = totalRetirementNeeds - totalIncome;
    const saveMoreScore = Math.min(100, Math.round((newPortfolio / portfolioNeeded) * 100));

    // Scenario 2: Work Longer - retire 2 years later
    const newRetirementAge = retirementAge + 2;
    const longerWorkYears = Math.max(0, newRetirementAge - currentAge);
    const longerRetirementYears = Math.max(0, lifeExpectancy - newRetirementAge);
    let workLongerPortfolio = investableAssets;
    for (let i = 0; i < longerWorkYears * 12; i++) {
      workLongerPortfolio = workLongerPortfolio * (1 + monthlyReturnRate) + monthlySavings;
    }
    const workLongerNeeds = monthlyExpenses * 12 * longerRetirementYears;
    const workLongerIncome = totalMonthlyIncome * 12 * longerRetirementYears;
    const workLongerGap = workLongerNeeds - workLongerIncome;
    const workLongerScore = Math.min(100, Math.round((workLongerPortfolio / workLongerGap) * 100));

    // Scenario 3: Expert Strategy - assume 2% better returns
    const expertReturn = annualReturn + 2;
    const expertMonthlyRate = expertReturn / 100 / 12;
    let expertPortfolio = investableAssets;
    for (let i = 0; i < yearsToRetirement * 12; i++) {
      expertPortfolio = expertPortfolio * (1 + expertMonthlyRate) + monthlySavings;
    }
    const expertScore = Math.min(100, Math.round((expertPortfolio / portfolioNeeded) * 100));

    return {
      saveMore: {
        additionalAmount: additionalSavingsNeeded,
        newScore: Math.max(score, saveMoreScore),
        improvement: Math.max(0, saveMoreScore - score)
      },
      workLonger: {
        newAge: newRetirementAge,
        yearsAdded: 2,
        newScore: Math.max(score, workLongerScore),
        improvement: Math.max(0, workLongerScore - score)
      },
      expertStrategy: {
        newScore: Math.max(score, expertScore),
        improvement: Math.max(0, expertScore - score)
      }
    };
  }, [calculations, score, monthlySavings, retirementAge, currentAge, investableAssets, 
      annualReturn, lifeExpectancy, monthlyExpenses, socialSecurityBenefit, additionalIncome]);

  // SVG gauge parameters
  const radius = 120;
  const strokeWidth = 24;
  const centerX = 150;
  const centerY = 150;
  const circumference = Math.PI * radius;
  const progressOffset = circumference - (score / 100) * circumference;

  return (
    <div className="min-h-screen bg-gray-50 flex flex-col">
      <header className="bg-white shadow-sm py-6">
        <h1 className="text-3xl font-bold text-center text-gray-900">RETIREMENT CALCULATOR</h1>
      </header>

      <div className="flex-1 flex">
        {/* Left Sidebar - Input Form */}
        <div className="w-1/3 bg-white border-r border-gray-200 overflow-hidden">
          <div className="p-8 h-full overflow-y-auto">
            {/* Personal Details */}
            <div className="mb-8">
              <h2 className="text-lg font-bold text-gray-900 mb-2">PERSONAL DETAILS</h2>
              <p className="text-sm text-gray-600 mb-6">Adjust your inputs below to see how the changes you make can impact your results.</p>

              <div className="space-y-5">
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2">What age do you plan to retire?</label>
                  <input
                    type="number"
                    value={retirementAge}
                    onChange={(e) => {
                      setRetirementAge(Number(e.target.value));
                      setShouldCalculate(false);
                    }}
                    className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2">Life Expectancy</label>
                  <input
                    type="number"
                    value={lifeExpectancy}
                    onChange={(e) => {
                      setLifeExpectancy(Number(e.target.value));
                      setShouldCalculate(false);
                    }}
                    className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Investable Assets</label>
                  <p className="text-xs text-gray-500 mb-2">This includes cash, bank funds, 401ks and IRAs. Do not include real estate or other tangible assets</p>
                  <div className="relative">
                    <span className="absolute left-3 top-2.5 text-gray-500">$</span>
                    <input
                      type="number"
                      value={investableAssets}
                      onChange={(e) => {
                        setInvestableAssets(Number(e.target.value));
                        setShouldCalculate(false);
                      }}
                      className="w-full pl-7 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    />
                  </div>
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2">Monthly Savings Until Retirement</label>
                  <div className="relative">
                    <span className="absolute left-3 top-2.5 text-gray-500">$</span>
                    <input
                      type="number"
                      value={monthlySavings}
                      onChange={(e) => {
                        setMonthlySavings(Number(e.target.value));
                        setShouldCalculate(false);
                      }}
                      className="w-full pl-7 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    />
                  </div>
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2">Expected Monthly Expenses During Retirement</label>
                  <div className="relative">
                    <span className="absolute left-3 top-2.5 text-gray-500">$</span>
                    <input
                      type="number"
                      value={monthlyExpenses}
                      onChange={(e) => {
                        setMonthlyExpenses(Number(e.target.value));
                        setShouldCalculate(false);
                      }}
                      className="w-full pl-7 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    />
                  </div>
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2">Annual Rate of Return</label>
                  <div className="relative">
                    <input
                      type="number"
                      step="0.1"
                      value={annualReturn}
                      onChange={(e) => {
                        setAnnualReturn(Number(e.target.value));
                        setShouldCalculate(false);
                      }}
                      className="w-full pr-8 pl-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    />
                    <span className="absolute right-3 top-2.5 text-gray-500">%</span>
                  </div>
                </div>
              </div>
            </div>

            {/* Social Security */}
            <div className="mb-8">
              <h2 className="text-lg font-bold text-gray-900 mb-6">SOCIAL SECURITY</h2>
              <div className="space-y-5">
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2">Avg. Annual Income Over Your Career</label>
                  <div className="relative">
                    <span className="absolute left-3 top-2.5 text-gray-500">$</span>
                    <input
                      type="number"
                      value={avgAnnualIncome}
                      onChange={(e) => {
                        setAvgAnnualIncome(Number(e.target.value));
                        setShouldCalculate(false);
                      }}
                      className="w-full pl-7 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    />
                  </div>
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2">Monthly Social Security Benefits</label>
                  <div className="relative">
                    <span className="absolute left-3 top-2.5 text-gray-500">$</span>
                    <input
                      type="number"
                      value={socialSecurityBenefit}
                      readOnly
                      className="w-full pl-7 pr-4 py-2 border border-gray-300 rounded-lg bg-gray-50 text-gray-600"
                    />
                  </div>
                  <p className="text-xs text-gray-500 mt-1">Automatically calculated</p>
                </div>
              </div>
            </div>

            {/* Additional Income */}
            <div className="mb-8">
              <h2 className="text-lg font-bold text-gray-900 mb-2">OTHER INCOME</h2>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Additional Monthly Income</label>
                <p className="text-xs text-gray-500 mb-2">Add up any sources of income you plan to receive during retirement excluding Social Security.</p>
                <div className="relative">
                  <span className="absolute left-3 top-2.5 text-gray-500">$</span>
                  <input
                    type="number"
                    value={additionalIncome}
                    onChange={(e) => {
                      setAdditionalIncome(Number(e.target.value));
                      setShouldCalculate(false);
                    }}
                    className="w-full pl-7 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                  />
                </div>
              </div>
            </div>

            {/* Inflation Rate */}
            <div className="mb-8">
              <h2 className="text-lg font-bold text-gray-900 mb-2">INFLATION RATE</h2>
              <p className="text-sm text-gray-600 mb-4">Our calculations account for a {inflationRate}% inflation rate. Use the slider to adjust the inflation rate manually.</p>
              <div>
                <input
                  type="range"
                  min="0"
                  max="10"
                  step="0.1"
                  value={inflationRate}
                  onChange={(e) => {
                    setInflationRate(Number(e.target.value));
                    setShouldCalculate(false);
                  }}
                  className="w-full"
                />
                <div className="text-right text-lg font-semibold text-gray-900 mt-2">{inflationRate.toFixed(2)}%</div>
              </div>
            </div>

            {/* Calculate Button */}
            <div className="mb-8">
              <button
                onClick={() => setShouldCalculate(true)}
                className="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-6 rounded-lg transition-colors shadow-md"
              >
                CALCULATE
              </button>
            </div>
          </div>
        </div>

        {/* Right Sidebar - Results */}
        <div className="w-2/3 bg-gray-50 p-8 overflow-y-auto">
          {/* Health Score */}
          <div className="bg-white rounded-lg shadow-md p-8 mb-6">
            <h2 className="text-xl font-bold text-center mb-6">Your Retire With Clarity Health Score</h2>
            
            <div className="flex flex-col items-center">
              <svg width="300" height="180" viewBox="0 0 300 180">
                {/* Background arc */}
                <path
                  d={`M ${centerX - radius} ${centerY} A ${radius} ${radius} 0 0 1 ${centerX + radius} ${centerY}`}
                  fill="none"
                  stroke="#E5E7EB"
                  strokeWidth={strokeWidth}
                  strokeLinecap="round"
                />
                {/* Progress arc */}
                <path
                  d={`M ${centerX - radius} ${centerY} A ${radius} ${radius} 0 0 1 ${centerX + radius} ${centerY}`}
                  fill="none"
                  stroke={scoreColor}
                  strokeWidth={strokeWidth}
                  strokeLinecap="round"
                  strokeDasharray={circumference}
                  strokeDashoffset={progressOffset}
                  style={{ transition: 'stroke-dashoffset 0.5s ease' }}
                />
                {/* Score text */}
                <text x={centerX} y={centerY - 10} textAnchor="middle" fontSize="56" fontWeight="bold" fill={scoreColor}>
                  {score}
                </text>
                <text x={centerX} y={centerY + 20} textAnchor="middle" fontSize="14" fill="#6B7280">
                  HEALTH SCORE
                </text>
              </svg>

              <div className="text-center mt-6">
                <h3 className="text-xl font-bold text-gray-900 mb-3">
                  You're {score}% prepared - {statusMessage}
                </h3>
                <p className="text-gray-600 max-w-lg">
                  {statusDescription}
                </p>
              </div>
            </div>
          </div>

          {/* Projection Chart */}
          <div className="bg-white rounded-lg shadow-md p-8 mb-6">
            <h2 className="text-xl font-bold mb-6">RETIREMENT PROJECTION</h2>
            {calculations && calculations.projectionData.length > 0 ? (
              <ResponsiveContainer width="100%" height={350}>
                <AreaChart data={calculations.projectionData} margin={{ top: 10, right: 30, left: 60, bottom: 5 }}>
                  <defs>
                    <linearGradient id="portfolioGradient" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="5%" stopColor="#1e3a8a" stopOpacity={0.8}/>
                      <stop offset="50%" stopColor="#3b82f6" stopOpacity={0.5}/>
                      <stop offset="95%" stopColor="#93c5fd" stopOpacity={0.2}/>
                    </linearGradient>
                    <linearGradient id="expensesGradient" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="5%" stopColor="#dc2626" stopOpacity={0.8}/>
                      <stop offset="50%" stopColor="#ef4444" stopOpacity={0.5}/>
                      <stop offset="95%" stopColor="#fca5a5" stopOpacity={0.2}/>
                    </linearGradient>
                  </defs>
                  <CartesianGrid strokeDasharray="3 3" stroke="#e5e7eb" />
                  <XAxis 
                    dataKey="age" 
                    label={{ value: 'Age', position: 'insideBottom', offset: -5, style: { fontSize: 14, fontWeight: 600 } }}
                    ticks={generateXAxisTicks()}
                    domain={[retirementAge, lifeExpectancy]}
                    type="number"
                    style={{ fontSize: 12 }}
                  />
                  <YAxis 
                    tickFormatter={formatYAxis}
                    width={80}
                    style={{ fontSize: 12 }}
                    label={{ 
                      value: 'Portfolio Value', 
                      angle: -90, 
                      position: 'insideLeft',
                      offset: 10,
                      style: { fontSize: 14, fontWeight: 600, textAnchor: 'middle' }
                    }}
                  />
                  <Tooltip 
                    formatter={(value) => `$${value.toLocaleString()}`}
                    contentStyle={{ backgroundColor: 'rgba(255, 255, 255, 0.95)', border: '1px solid #e5e7eb', borderRadius: 8 }}
                  />
                  <Legend 
                    wrapperStyle={{ paddingTop: 20 }}
                  />
                  <Area 
                    type="monotone" 
                    dataKey="portfolio" 
                    stroke="#1e3a8a" 
                    strokeWidth={3} 
                    fill="url(#portfolioGradient)"
                    name="Portfolio Balance"
                  />
                  <Area 
                    type="monotone" 
                    dataKey="expenses" 
                    stroke="#dc2626" 
                    strokeWidth={3} 
                    fill="url(#expensesGradient)"
                    name="Annual Expenses"
                  />
                </AreaChart>
              </ResponsiveContainer>
            ) : (
              <div className="text-center text-gray-500 py-12">
                Click CALCULATE to see your retirement projection
              </div>
            )}
          </div>

          {/* CTA Card */}
          <div className="bg-gradient-to-br from-blue-600 to-blue-700 rounded-lg shadow-md p-8 text-white">
            <h2 className="text-2xl font-bold mb-4">OPTIMIZE YOUR RETIREMENT PLAN</h2>
            <p className="mb-6 text-blue-100">Get personalized guidance from a retirement specialist</p>
            
            <div className="space-y-2 mb-6">
              <div className="flex items-center">
                <span className="mr-2">✓</span> Comprehensive plan review
              </div>
              <div className="flex items-center">
                <span className="mr-2">✓</span> Tax optimization strategies
              </div>
              <div className="flex items-center">
                <span className="mr-2">✓</span> Portfolio rebalancing advice
              </div>
              <div className="flex items-center">
                <span className="mr-2">✓</span> Social Security maximization
              </div>
            </div>

            <button className="w-full bg-white text-blue-700 font-bold py-4 px-6 rounded-lg hover:bg-blue-50 transition-colors">
              BOOK FREE CONSULTATION
              <div className="text-sm font-normal">(30 minutes)</div>
            </button>

            <p className="text-center text-blue-100 text-sm mt-4">No obligation • 100% confidential</p>
          </div>
        </div>
      </div>
    </div>
  );
};

export default RetirementCalculator;
